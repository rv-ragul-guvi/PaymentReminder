# Environment Variables for GUVI Payment Reminder Service
PROJECT_NAME="GUVI Payment Reminder Service"
DEBUG=false

# Database Configuration (defaults to sqlite+aiosqlite; can use postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL="sqlite+aiosqlite:///./payment_reminders.db"

# Company Details
COMPANY_NAME="GUVI"
COMPANY_SUPPORT_EMAIL="support@guvi.in"
COURSES_TEAM_EMAIL="courses-team@guvi.in"
BASE_PAYMENT_GATEWAY_URL="https://pay.guvi.in/checkout"

# Notification Channels
DEFAULT_NOTIFICATION_CHANNEL="EMAIL"
ENABLE_EMAIL_CHANNEL=true
ENABLE_SMS_CHANNEL=false
ENABLE_WHATSAPP_CHANNEL=false

# Email Mode: "MOCK" (for local testing/dev, logs messages) or "SMTP" (real email dispatch)
EMAIL_MODE="MOCK"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="admissions@guvi.in"
SMTP_PASSWORD="your-app-password"
SMTP_TLS=true
EMAILS_FROM_EMAIL="admissions@guvi.in"
EMAILS_FROM_NAME="Team GUVI"

# Reminder Schedules & Thresholds
PENDING_REMINDER_INITIAL_DELAY_HOURS=24
REMINDER_COOLDOWN_HOURS=24
MAX_PENDING_REMINDERS=3
DP_CONVERSION_WINDOW_HOURS=48
SCHEDULER_INTERVAL_SECONDS=300
